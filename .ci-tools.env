# Everything this repository has to say about itself to the shared ci-tools
# submodule. Sourced by ci-tools/monorepo/lib.sh, so a laptop and a runner read
# the same values and no workflow step repeats them.

# Charts publish as OCI artifacts here. No default in ci-tools: a shared repo
# must not guess a registry.
OCI_REGISTRY=oci://ghcr.io/seregazh/charts

# The version lives in a git tag `<chart>-<major>.<minor>.<patch>`, e.g.
# monitoring-extensions-0.1.0 — a dash, not the `/v` default, because that is
# what the published tags already use.
CI_TAG_SEP=-

# Pinned toolchain, so local and CI cannot drift apart.
KUBECONFORM_VERSION=v0.6.7
PROMETHEUS_VERSION=3.6.0
